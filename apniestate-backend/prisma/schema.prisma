generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  ADMIN
  BUILDER
  SITE_SUPERVISOR
  ACCOUNTANT
  INVENTORY_MANAGER
  PROJECT_MANAGER
  WORKER
  VENDOR
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum BOQStatus {
  DRAFT
  APPROVED
  REVISED
}

enum SiteStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  QUOTATION
  APPROVED
  REJECTED
  ORDERED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum MaterialStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ORDERED
  DELIVERED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SENT
  PARTIAL
  DELIVERED
  CANCELLED
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  UNDER_MAINTENANCE
  RETIRED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  UPI
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ChangeOrderStatus {
  PROPOSED
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum DailyReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum WeeklyReportStatus {
  DRAFT
  GENERATED
  APPROVED
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUST
  GRN_RECEIPT
  MATERIAL_ISSUE
  RETURN
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum GRNStatus {
  DRAFT
  VERIFIED
  DISPUTED
}

enum MaterialIssueStatus {
  PENDING
  APPROVED
  ISSUED
  REJECTED
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  LATE
}

enum ShiftType {
  DAY
  NIGHT
  GENERAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  EMERGENCY
}

enum BudgetCategory {
  MATERIALS
  EQUIPMENT
  OVERHEAD
  SUBCONTRACT
  CONTINGENCY
  MATERIAL
  GENERAL
  LABOUR
  STOCK_TRANSFER
  SUBCONTRACTS
  BROKER
  OFFICE
  OTHER
}

enum UnitType {
  HOUSE
  MALL_SHOP
  RESTAURANT
  OFFICE
  OTHER
}

enum UnitStatus {
  VACANT
  BOOKED
  SOLD
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  EQUITY
}

enum CashbookType {
  CREDIT
  DEBIT
}

enum VendorType {
  MATERIAL_SUPPLIER
  EQUIPMENT_VENDOR
  SERVICE_PROVIDER
  SUBCONTRACTOR_VENDOR
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  APPROVED
}

enum ResignationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

// ─── Core Models ─────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password_hash     String
  role              Role     @default(SITE_SUPERVISOR)
  phone             String?
  is_active         Boolean  @default(true)
  onboarded         Boolean  @default(false)
  last_workspace_id String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  projects          Project[]              @relation("BuilderProjects")
  managed_projects  Project[]              @relation("ManagerProjects")
  supervised        Site[]                 @relation("SupervisorSites")
  attendances       SiteAttendance[]
  daily_reports     DailyReport[]
  material_reqs     MaterialRequest[]
  notifications     Notification[]
  refresh_tokens    RefreshToken[]
  documents         Document[]
  assigned_tasks    Task[]                 @relation("TaskAssignee")
  created_tasks     Task[]                 @relation("TaskCreator")
  expenses          Expense[]
  activity_logs     ActivityLog[]
  purchase_requests PurchaseRequest[]
  inventory_txns    InventoryTransaction[]
  task_comments     TaskComment[]
  approved_leaves   Leave[]                @relation("LeaveApprover")
  vendor_ratings    VendorRating[]
  budget_entries    Budget[]
  cashbook_entries  Cashbook[]
  reports           Report[]
  reminders         Reminder[]
  purchase_orders   PurchaseOrder[]
  attachments       Attachment[]
  approval_logs     ApprovalLog[]
  weekly_reports    WeeklyReport[]

  // Enterprise membership relations
  invitations_sent       Invitation[]        @relation("InvitationSender")
  project_assignments    ProjectAssignment[] @relation("AssignedUser")
  assignments_given      ProjectAssignment[] @relation("AssignmentGiver")
  site_assignments       SiteAssignment[]    @relation("SiteAssignedUser")
  site_assignments_given SiteAssignment[]    @relation("SiteAssignmentGiver")
  resignations           Resignation[]       @relation("ResigningUser")
  resignation_reviews    Resignation[]       @relation("ResignationReviewer")

  material_requests_approved MaterialRequest[]   @relation("MaterialRequestApprover")
  material_issues_requested  MaterialIssue[]     @relation("MaterialIssueRequester")
  material_issues_approved   MaterialIssue[]     @relation("MaterialIssueApprover")
  rfqs_created               RFQ[]
  boqs_created               BOQ[]               @relation("BOQCreator")
  boqs_approved              BOQ[]               @relation("BOQApprover")
  grns_received              GoodsReceiptNote[]
  company_id                 String?
  company                    Company?            @relation(fields: [company_id], references: [id])
  memberships                CompanyMembership[]

  @@index([company_id], name: "idx_user_company_id")
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(cuid())
  user_id    String
  token_hash String
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_refresh_tokens_user_id")
  @@map("refresh_tokens")
}

// ─── Permissions ─────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  module      String // e.g. "projects", "workers", "finance"
  action      String // e.g. "create", "read", "update", "delete", "approve"
  description String?
  created_at  DateTime @default(now())

  role_permissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id            String   @id @default(cuid())
  role          Role
  permission_id String
  created_at    DateTime @default(now())

  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role, permission_id])
  @@index([role], name: "idx_role_permissions_role")
  @@map("role_permissions")
}

// ─── Projects & Sites ────────────────────────────────────

model Project {
  id                  String        @id @default(cuid())
  name                String
  description         String?
  builder_id          String
  manager_id          String?
  status              ProjectStatus @default(PLANNING)
  start_date          DateTime
  end_date            DateTime?
  budget              Float?
  actual_cost         Float?        @default(0)
  progress_percentage Int?          @default(0)
  address             String?
  city                String?
  client_name         String?
  gps_coordinates     String?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  builder             User                @relation("BuilderProjects", fields: [builder_id], references: [id])
  manager             User?               @relation("ManagerProjects", fields: [manager_id], references: [id])
  sites               Site[]
  milestones          Milestone[]
  change_orders       ChangeOrder[]
  tasks               Task[]
  budgets             Budget[]
  workers             Worker[]            @relation("ProjectWorkers")
  delays              ProjectDelay[]
  risks               ProjectRisk[]
  purchase_orders     PurchaseOrder[]
  cashbook_entries    Cashbook[]
  expenses            Expense[]
  project_assignments ProjectAssignment[]
  units               ProjectUnit[]
  daily_reports       DailyReport[]
  weekly_reports      WeeklyReport[]
  rfqs                RFQ[]
  boqs                BOQ[]
  company_id          String?
  company             Company?            @relation(fields: [company_id], references: [id])
  Equipment           Equipment[]

  @@index([builder_id], name: "idx_projects_builder_id")
  @@index([manager_id], name: "idx_projects_manager_id")
  @@index([company_id], name: "idx_project_company_id")
  @@map("projects")
}

model ProjectUnit {
  id          String     @id @default(cuid())
  project_id  String
  unit_number String
  type        UnitType   @default(OTHER)
  custom_type String?
  status      UnitStatus @default(VACANT)
  price       Float?
  client_name String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@map("project_units")
}

model Site {
  id                  String     @id @default(cuid())
  project_id          String
  name                String
  location            String
  supervisor_id       String?
  status              SiteStatus @default(NOT_STARTED)
  progress_percentage Int?       @default(0)
  phase               String?
  gps_coordinates     String?
  working_hours_start String?
  working_hours_end   String?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  project               Project               @relation(fields: [project_id], references: [id])
  supervisor            User?                 @relation("SupervisorSites", fields: [supervisor_id], references: [id])
  attendances           SiteAttendance[]
  daily_reports         DailyReport[]
  weekly_reports        WeeklyReport[]
  material_reqs         MaterialRequest[]
  equipment             Equipment[]
  tasks                 Task[]
  inventory             InventoryItem[]
  expenses              Expense[]
  workers               Worker[]              @relation("SiteWorkers")
  labour_teams          LabourTeam[]
  worker_attendances    WorkerAttendance[]
  worker_transfers      WorkerTransfer[]
  purchase_orders       PurchaseOrder[]
  budgets               Budget[]
  cashbook_entries      Cashbook[]
  site_assignments      SiteAssignment[]
  rfqs                  RFQ[]
  grns                  GoodsReceiptNote[]
  material_issues       MaterialIssue[]
  material_consumptions MaterialConsumption[]
  company_id            String?
  company               Company?              @relation(fields: [company_id], references: [id])
  LabourLog             LabourLog[]

  @@index([project_id], name: "idx_sites_project_id")
  @@index([supervisor_id], name: "idx_sites_supervisor_id")
  @@index([company_id], name: "idx_site_company_id")
  @@map("sites")
}

// ─── Tasks & Milestones ──────────────────────────────────

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  project_id    String?
  site_id       String?
  assignee_id   String?
  created_by    String
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  due_date      DateTime?
  completed_at  DateTime?
  reminder_days Int?         @default(1)
  reminder_sent Boolean?     @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  project      Project?         @relation(fields: [project_id], references: [id])
  site         Site?            @relation(fields: [site_id], references: [id])
  assignee     User?            @relation("TaskAssignee", fields: [assignee_id], references: [id])
  creator      User             @relation("TaskCreator", fields: [created_by], references: [id])
  comments     TaskComment[]
  attachments  TaskAttachment[]
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependsOnTask")
  company_id   String?
  company      Company?         @relation(fields: [company_id], references: [id])

  @@index([project_id], name: "idx_tasks_project_id")
  @@index([site_id], name: "idx_tasks_site_id")
  @@index([assignee_id], name: "idx_tasks_assignee_id")
  @@index([status], name: "idx_tasks_status")
  @@index([company_id], name: "idx_task_company_id")
  @@map("tasks")
}

model TaskComment {
  id         String   @id @default(cuid())
  task_id    String
  user_id    String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id])

  @@index([task_id], name: "idx_task_comments_task_id")
  @@map("task_comments")
}

model TaskAttachment {
  id         String   @id @default(cuid())
  task_id    String
  name       String
  file_url   String
  file_size  Int?
  created_at DateTime @default(now())

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@index([task_id], name: "idx_task_attachments_task_id")
  @@map("task_attachments")
}

model TaskDependency {
  id            String         @id @default(cuid())
  task_id       String
  depends_on_id String
  type          DependencyType @default(FINISH_TO_START)
  created_at    DateTime       @default(now())

  task       Task @relation("DependentTask", fields: [task_id], references: [id], onDelete: Cascade)
  depends_on Task @relation("DependsOnTask", fields: [depends_on_id], references: [id], onDelete: Cascade)

  @@unique([task_id, depends_on_id])
  @@map("task_dependencies")
}

model Milestone {
  id          String          @id @default(cuid())
  project_id  String
  name        String
  description String?
  target_date DateTime
  actual_date DateTime?
  weight      Int?            @default(1)
  status      MilestoneStatus @default(PENDING)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id], name: "idx_milestones_project_id")
  @@map("milestones")
}

// ─── Project Delays & Risks ──────────────────────────────

model ProjectDelay {
  id          String    @id @default(cuid())
  project_id  String
  reason      String
  delay_days  Int
  impact      String?
  reported_at DateTime  @default(now())
  resolved_at DateTime?
  created_at  DateTime  @default(now())

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id], name: "idx_project_delays_project_id")
  @@map("project_delays")
}

model ProjectRisk {
  id          String   @id @default(cuid())
  project_id  String
  title       String
  description String?
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  probability String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  mitigation  String?
  status      String   @default("OPEN") // OPEN, MITIGATED, CLOSED
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id], name: "idx_project_risks_project_id")
  @@map("project_risks")
}

// ─── Workforce ───────────────────────────────────────────

model Worker {
  id                     String       @id @default(cuid())
  employee_id            String?      @unique
  name                   String
  phone                  String?
  trade                  String // e.g. Mason, Electrician, Plumber
  skill_level            String?
  daily_rate             Float?
  overtime_rate_per_hour Float?
  contractor_id          String?
  site_id                String?
  project_id             String?
  status                 WorkerStatus @default(ACTIVE)
  address                String?
  aadhaar_number         String?
  bank_account           String?
  bank_ifsc              String?
  date_of_joining        DateTime?
  is_active              Boolean      @default(true)
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  contractor         Contractor?              @relation(fields: [contractor_id], references: [id])
  site               Site?                    @relation("SiteWorkers", fields: [site_id], references: [id])
  project            Project?                 @relation("ProjectWorkers", fields: [project_id], references: [id])
  attendances        WorkerAttendance[]
  documents          WorkerDocument[]
  wages              WorkerWage[]
  transfers          WorkerTransfer[]         @relation("TransferFrom")
  emergency_contacts WorkerEmergencyContact[]
  leaves             Leave[]
  labour_team_id     String?
  labour_team        LabourTeam?              @relation(fields: [labour_team_id], references: [id])
  company_id         String?
  company            Company?                 @relation(fields: [company_id], references: [id])

  @@index([contractor_id], name: "idx_workers_contractor_id")
  @@index([site_id], name: "idx_workers_site_id")
  @@index([project_id], name: "idx_workers_project_id")
  @@index([status], name: "idx_workers_status")
  @@index([company_id], name: "idx_worker_company_id")
  @@map("workers")
}

model Contractor {
  id         String   @id @default(cuid())
  name       String
  company    String?
  phone      String?
  email      String?
  trade      String?
  address    String?
  gst_number String?
  pan_number String?
  rating     Float?   @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  workers       Worker[]
  payments      Payment[]
  company_id    String?
  owner_company Company?  @relation(fields: [company_id], references: [id])

  @@index([company_id], name: "idx_contractor_company_id")
  @@map("contractors")
}

model Subcontractor {
  id             String   @id @default(cuid())
  name           String
  company        String?
  phone          String?
  email          String?
  specialization String?
  address        String?
  gst_number     String?
  pan_number     String?
  contract_value Float?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  company_id     String?
  owner_company  Company? @relation(fields: [company_id], references: [id])

  @@index([company_id], name: "idx_subcontractor_company_id")
  @@map("subcontractors")
}

model LabourTeam {
  id            String   @id @default(cuid())
  name          String
  site_id       String
  supervisor_id String?
  trade         String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  site    Site     @relation(fields: [site_id], references: [id])
  workers Worker[]

  @@index([site_id], name: "idx_labour_teams_site_id")
  @@map("labour_teams")
}

model WorkerDocument {
  id          String    @id @default(cuid())
  worker_id   String
  type        String // e.g. "ID_PROOF", "CONTRACT", "CERTIFICATION", "MEDICAL"
  name        String
  file_url    String
  expiry_date DateTime?
  created_at  DateTime  @default(now())

  worker Worker @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@index([worker_id], name: "idx_worker_documents_worker_id")
  @@map("worker_documents")
}

model WorkerWage {
  id             String        @id @default(cuid())
  worker_id      String
  period_start   DateTime      @db.Date
  period_end     DateTime      @db.Date
  present_days   Int           @default(0)
  overtime_hours Float         @default(0)
  daily_rate     Float
  overtime_rate  Float?
  bonus          Float         @default(0)
  advances       Float         @default(0)
  late_penalty   Float         @default(0)
  gross_amount   Float
  deductions     Float         @default(0)
  net_amount     Float
  status         PaymentStatus @default(PENDING)
  paid_at        DateTime?
  notes          String?
  is_locked      Boolean       @default(false)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  worker Worker @relation(fields: [worker_id], references: [id])

  @@index([worker_id], name: "idx_worker_wages_worker_id")
  @@index([period_start], name: "idx_worker_wages_period")
  @@map("worker_wages")
}

model WorkerTransfer {
  id            String   @id @default(cuid())
  worker_id     String
  from_site_id  String?
  to_site_id    String
  transfer_date DateTime @db.Date
  reason        String?
  created_at    DateTime @default(now())

  worker  Worker @relation("TransferFrom", fields: [worker_id], references: [id])
  to_site Site   @relation(fields: [to_site_id], references: [id])
  // Worker.transfers_to uses the same worker_id but tracks incoming transfers

  @@index([worker_id], name: "idx_worker_transfers_worker_id")
  @@map("worker_transfers")
}

model WorkerEmergencyContact {
  id           String @id @default(cuid())
  worker_id    String
  name         String
  phone        String
  relationship String

  worker Worker @relation(fields: [worker_id], references: [id], onDelete: Cascade)

  @@index([worker_id], name: "idx_worker_emergency_worker_id")
  @@map("worker_emergency_contacts")
}

// ─── Attendance ──────────────────────────────────────────

model SiteAttendance {
  id         String    @id @default(cuid())
  site_id    String
  worker_id  String
  date       DateTime  @db.Date
  check_in   DateTime?
  check_out  DateTime?
  notes      String?
  created_at DateTime  @default(now())

  site   Site @relation(fields: [site_id], references: [id])
  worker User @relation(fields: [worker_id], references: [id])

  @@index([site_id], name: "idx_attendances_site_id")
  @@index([worker_id], name: "idx_attendances_worker_id")
  @@index([date], name: "idx_attendances_date")
  @@map("site_attendances")
}

model WorkerAttendance {
  id                  String           @id @default(cuid())
  worker_id           String
  site_id             String?
  date                DateTime         @db.Date
  status              AttendanceStatus @default(PRESENT)
  shift               ShiftType        @default(GENERAL)
  check_in            DateTime?
  check_out           DateTime?
  overtime_hours      Float?           @default(0)
  daily_wage_snapshot Float?
  is_half_day         Boolean          @default(false)
  is_late             Boolean          @default(false)
  notes               String?
  marked_by           String?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  worker Worker @relation(fields: [worker_id], references: [id])
  site   Site?  @relation(fields: [site_id], references: [id])

  @@unique([worker_id, date])
  @@index([date], name: "idx_worker_attendance_date")
  @@index([site_id], name: "idx_worker_attendance_site_id")
  @@index([status], name: "idx_worker_attendance_status")
  @@map("worker_attendances")
}

model Leave {
  id          String      @id @default(cuid())
  worker_id   String
  type        LeaveType   @default(CASUAL)
  from_date   DateTime    @db.Date
  to_date     DateTime    @db.Date
  reason      String?
  status      LeaveStatus @default(PENDING)
  approved_by String?
  approved_at DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  worker   Worker @relation(fields: [worker_id], references: [id])
  approver User?  @relation("LeaveApprover", fields: [approved_by], references: [id])

  @@index([worker_id], name: "idx_leaves_worker_id")
  @@index([status], name: "idx_leaves_status")
  @@map("leaves")
}

// ─── Materials & Inventory ───────────────────────────────

model Material {
  id                  String         @id @default(cuid())
  code                String?        @unique
  name                String
  category            String?
  unit                String
  brand               String?
  specification       String?
  preferred_vendor_id String?
  min_stock           Float          @default(0)
  reorder_level       Float          @default(0)
  max_stock           Float          @default(0)
  status              MaterialStatus @default(ACTIVE)
  description         String?
  created_at          DateTime       @default(now())

  preferred_vendor Vendor?               @relation(fields: [preferred_vendor_id], references: [id])
  requests         MaterialRequest[]
  inventory        InventoryItem[]
  purchase_items   PurchaseRequestItem[]
  po_items         PurchaseOrderItem[]

  rfq_items       RFQItem[]
  quotation_items QuotationItem[]
  grn_items       GoodsReceiptNoteItem[]
  issue_items     MaterialIssueItem[]
  consumptions    MaterialConsumption[]
  company_id      String?
  company         Company?               @relation(fields: [company_id], references: [id])
  BOQItem         BOQItem[]

  @@index([company_id], name: "idx_material_company_id")
  @@index([preferred_vendor_id], name: "idx_material_vendor_id")
  @@map("materials")
}

enum RequestPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

model MaterialRequest {
  id                     String                @id @default(cuid())
  site_id                String
  material_id            String
  quantity               Float
  approved_quantity      Float?
  assigned_vendor_id     String?
  expected_delivery_date DateTime?             @db.Date
  status                 MaterialRequestStatus @default(DRAFT)
  priority               RequestPriority       @default(NORMAL)
  requested_by           String
  approved_by            String?
  notes                  String?
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  site      Site     @relation(fields: [site_id], references: [id])
  material  Material @relation(fields: [material_id], references: [id])
  requester User     @relation(fields: [requested_by], references: [id])
  approver  User?    @relation("MaterialRequestApprover", fields: [approved_by], references: [id])
  vendor    Vendor?  @relation(fields: [assigned_vendor_id], references: [id])

  @@index([site_id], name: "idx_material_requests_site_id")
  @@index([status], name: "idx_material_requests_status")
  @@map("material_requests")
}

model InventoryItem {
  id           String   @id @default(cuid())
  material_id  String
  site_id      String
  quantity     Float    @default(0)
  min_quantity Float    @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  material     Material               @relation(fields: [material_id], references: [id])
  site         Site                   @relation(fields: [site_id], references: [id])
  transactions InventoryTransaction[]
  company_id   String?
  company      Company?               @relation(fields: [company_id], references: [id])

  @@unique([material_id, site_id])
  @@index([site_id], name: "idx_inventory_site_id")
  @@index([company_id], name: "idx_inventoryitem_company_id")
  @@map("inventory_items")
}

model InventoryTransaction {
  id         String                   @id @default(cuid())
  item_id    String
  type       InventoryTransactionType
  quantity   Float
  notes      String?
  user_id    String
  created_at DateTime                 @default(now())

  item InventoryItem @relation(fields: [item_id], references: [id])
  user User          @relation(fields: [user_id], references: [id])

  @@index([item_id], name: "idx_inv_txn_item_id")
  @@map("inventory_transactions")
}

model PurchaseRequest {
  id           String                @id @default(cuid())
  site_id      String?
  requested_by String
  approved_by  String?
  vendor_id    String?
  status       PurchaseRequestStatus @default(DRAFT)
  total_amount Float?
  notes        String?
  created_at   DateTime              @default(now())
  updated_at   DateTime              @updatedAt

  requester User                  @relation(fields: [requested_by], references: [id])
  vendor    Vendor?               @relation(fields: [vendor_id], references: [id])
  items     PurchaseRequestItem[]

  @@index([status], name: "idx_purchase_requests_status")
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id          String @id @default(cuid())
  request_id  String
  material_id String
  quantity    Float
  unit_price  Float?
  total       Float?

  request  PurchaseRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  material Material        @relation(fields: [material_id], references: [id])

  @@map("purchase_request_items")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  po_number        String              @unique
  vendor_id        String
  project_id       String?
  site_id          String?
  created_by       String
  status           PurchaseOrderStatus @default(DRAFT)
  delivery_date    DateTime?           @db.Date
  total_amount     Float               @default(0)
  gst_amount       Float               @default(0)
  discount_amount  Float               @default(0)
  terms_conditions String?
  notes            String?
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  vendor     Vendor              @relation(fields: [vendor_id], references: [id])
  project    Project?            @relation(fields: [project_id], references: [id])
  site       Site?               @relation(fields: [site_id], references: [id])
  creator    User                @relation(fields: [created_by], references: [id])
  items      PurchaseOrderItem[]
  grns       GoodsReceiptNote[]
  company_id String?
  company    Company?            @relation(fields: [company_id], references: [id])

  @@index([vendor_id], name: "idx_purchase_orders_vendor_id")
  @@index([project_id], name: "idx_purchase_orders_project_id")
  @@index([site_id], name: "idx_purchase_orders_site_id")
  @@index([status], name: "idx_purchase_orders_status")
  @@index([company_id], name: "idx_purchaseorder_company_id")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String @id @default(cuid())
  purchase_order_id String
  material_id       String
  quantity          Float
  received_quantity Float  @default(0)
  unit_price        Float
  gst_rate          Float  @default(0)
  total             Float

  purchase_order PurchaseOrder @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
  material       Material      @relation(fields: [material_id], references: [id])

  @@index([purchase_order_id], name: "idx_po_items_po_id")
  @@map("purchase_order_items")
}

// ─── RFQ & Quotations ────────────────────────────────────

model RFQ {
  id         String    @id @default(cuid())
  project_id String?
  site_id    String?
  company_id String
  created_by String
  status     RFQStatus @default(DRAFT)
  due_date   DateTime? @db.Date
  notes      String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  project    Project?    @relation(fields: [project_id], references: [id])
  site       Site?       @relation(fields: [site_id], references: [id])
  company    Company     @relation(fields: [company_id], references: [id])
  creator    User        @relation(fields: [created_by], references: [id])
  items      RFQItem[]
  quotations Quotation[]

  @@index([company_id], name: "idx_rfq_company")
  @@map("rfqs")
}

model RFQItem {
  id          String @id @default(cuid())
  rfq_id      String
  material_id String
  quantity    Float

  rfq      RFQ      @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  material Material @relation(fields: [material_id], references: [id])

  @@map("rfq_items")
}

model Quotation {
  id             String          @id @default(cuid())
  rfq_id         String
  vendor_id      String
  status         QuotationStatus @default(DRAFT)
  total_amount   Float           @default(0)
  gst_amount     Float           @default(0)
  transportation Float           @default(0)
  delivery_time  String?
  validity_days  Int?
  terms          String?
  is_recommended Boolean         @default(false)
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  rfq    RFQ             @relation(fields: [rfq_id], references: [id], onDelete: Cascade)
  vendor Vendor          @relation(fields: [vendor_id], references: [id])
  items  QuotationItem[]

  @@unique([rfq_id, vendor_id])
  @@map("quotations")
}

model QuotationItem {
  id           String @id @default(cuid())
  quotation_id String
  material_id  String
  quantity     Float
  rate         Float
  total        Float

  quotation Quotation @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  material  Material  @relation(fields: [material_id], references: [id])

  @@map("quotation_items")
}

// ─── Goods Receipt Note (GRN) ────────────────────────────

model GoodsReceiptNote {
  id             String    @id @default(cuid())
  po_id          String
  site_id        String
  received_by    String
  date           DateTime  @default(now())
  status         GRNStatus @default(DRAFT)
  quality_status String    @default("GOOD")
  remarks        String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  purchase_order PurchaseOrder          @relation(fields: [po_id], references: [id])
  site           Site                   @relation(fields: [site_id], references: [id])
  receiver       User                   @relation(fields: [received_by], references: [id])
  items          GoodsReceiptNoteItem[]

  @@map("goods_receipt_notes")
}

model GoodsReceiptNoteItem {
  id           String @id @default(cuid())
  grn_id       String
  material_id  String
  ordered_qty  Float
  received_qty Float
  rejected_qty Float  @default(0)
  damaged_qty  Float  @default(0)
  short_supply Float  @default(0)

  grn      GoodsReceiptNote @relation(fields: [grn_id], references: [id], onDelete: Cascade)
  material Material         @relation(fields: [material_id], references: [id])

  @@map("goods_receipt_note_items")
}

// ─── Material Issue & Consumption ────────────────────────

model MaterialIssue {
  id           String              @id @default(cuid())
  site_id      String
  requested_by String
  approved_by  String?
  date         DateTime            @default(now())
  purpose      String?
  status       MaterialIssueStatus @default(PENDING)
  created_at   DateTime            @default(now())
  updated_at   DateTime            @updatedAt

  site      Site                @relation(fields: [site_id], references: [id])
  requester User                @relation("MaterialIssueRequester", fields: [requested_by], references: [id])
  approver  User?               @relation("MaterialIssueApprover", fields: [approved_by], references: [id])
  items     MaterialIssueItem[]

  @@map("material_issues")
}

model MaterialIssueItem {
  id          String @id @default(cuid())
  issue_id    String
  material_id String
  quantity    Float

  issue    MaterialIssue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [material_id], references: [id])

  @@map("material_issue_items")
}

model MaterialConsumption {
  id          String   @id @default(cuid())
  site_id     String
  material_id String
  quantity    Float
  date        DateTime @default(now())
  dpr_id      String?
  boq_id      String?
  created_at  DateTime @default(now())

  site     Site         @relation(fields: [site_id], references: [id])
  material Material     @relation(fields: [material_id], references: [id])
  dpr      DailyReport? @relation(fields: [dpr_id], references: [id])

  @@map("material_consumptions")
}

// ─── Vendors & Equipment ─────────────────────────────────

model Vendor {
  id             String     @id @default(cuid())
  name           String
  type           VendorType @default(MATERIAL_SUPPLIER)
  contact_person String?
  phone          String?
  email          String?
  address        String?
  category       String?
  gst_number     String?
  pan_number     String?
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  equipment           Equipment[]
  invoices            Invoice[]
  payments            Payment[]
  ratings             VendorRating[]
  purchase_requests   PurchaseRequest[]
  purchase_orders     PurchaseOrder[]
  preferred_materials Material[]
  expenses            Expense[]
  cashbook_entries    Cashbook[]

  quotations        Quotation[]
  material_requests MaterialRequest[]
  company_id        String?
  company           Company?          @relation(fields: [company_id], references: [id])

  @@index([company_id], name: "idx_vendor_company_id")
  @@map("vendors")
}

model VendorRating {
  id         String   @id @default(cuid())
  vendor_id  String
  user_id    String
  score      Int // 1-5
  comment    String?
  created_at DateTime @default(now())

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id])

  @@index([vendor_id], name: "idx_vendor_ratings_vendor_id")
  @@map("vendor_ratings")
}

model Equipment {
  id               String          @id @default(cuid())
  name             String
  type             String
  site_id          String?
  project_id       String?
  vendor_id        String?
  company_id       String?
  ownership        String          @default("OWNED") // OWNED / RENTED
  rental_cost      Float           @default(0)
  fuel_cost        Float           @default(0)
  operator_cost    Float           @default(0)
  maintenance_cost Float           @default(0)
  status           EquipmentStatus @default(AVAILABLE)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  site    Site?          @relation(fields: [site_id], references: [id])
  vendor  Vendor?        @relation(fields: [vendor_id], references: [id])
  project Project?       @relation(fields: [project_id], references: [id])
  company Company?       @relation(fields: [company_id], references: [id])
  logs    EquipmentLog[]

  @@index([site_id], name: "idx_equipment_site_id")
  @@index([project_id])
  @@index([company_id])
  @@map("equipment")
}

model EquipmentLog {
  id            String   @id @default(cuid())
  equipment_id  String
  date          DateTime @db.Date
  running_hours Float    @default(0)
  fuel_used     Float    @default(0)
  status        String
  notes         String?
  created_at    DateTime @default(now())

  equipment Equipment @relation(fields: [equipment_id], references: [id])

  @@index([equipment_id, date])
  @@map("equipment_logs")
}

model LabourCategory {
  id                  String   @id @default(cuid())
  company_id          String
  name                String
  daily_wage          Float
  half_day_multiplier Float    @default(0.5)
  ot_multiplier       Float    @default(1.5)
  status              String   @default("ACTIVE") // ACTIVE / INACTIVE
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  company Company     @relation(fields: [company_id], references: [id])
  logs    LabourLog[]

  @@index([company_id])
  @@map("labour_categories")
}

model LabourLog {
  id             String   @id @default(cuid())
  site_id        String
  date           DateTime @db.Date
  category_id    String
  present_count  Int      @default(0)
  half_day_count Int      @default(0)
  ot_hours       Float    @default(0)
  regular_cost   Float    @default(0)
  half_day_cost  Float    @default(0)
  ot_cost        Float    @default(0)
  total_cost     Float    @default(0)
  marked_by      String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  category LabourCategory @relation(fields: [category_id], references: [id])
  site     Site           @relation(fields: [site_id], references: [id])

  @@index([site_id, date])
  @@map("labour_logs")
}

// ─── Finance ─────────────────────────────────────────────

model Expense {
  id          String        @id @default(cuid())
  amount      Float
  category    String
  description String?
  site_id     String?
  project_id  String?
  vendor_id   String?
  invoice_id  String?
  user_id     String
  date        DateTime      @db.Date
  receipt_url  String?
  status       ExpenseStatus @default(PENDING)
  reference_id String?       @unique // Used to link to external entities like attendance or POs for idempotency
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  site       Site?    @relation(fields: [site_id], references: [id])
  project    Project? @relation(fields: [project_id], references: [id])
  vendor     Vendor?  @relation(fields: [vendor_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([site_id], name: "idx_expenses_site_id")
  @@index([project_id], name: "idx_expenses_project_id")
  @@index([vendor_id], name: "idx_expenses_vendor_id")
  @@index([date], name: "idx_expenses_date")
  @@index([company_id], name: "idx_expense_company_id")
  @@map("expenses")
}

model Payment {
  id            String        @id @default(cuid())
  amount        Float
  vendor_id     String?
  contractor_id String?
  invoice_id    String?
  date          DateTime      @db.Date
  method        PaymentMethod @default(BANK_TRANSFER)
  status        PaymentStatus @default(PENDING)
  reference     String?
  notes         String?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  vendor     Vendor?     @relation(fields: [vendor_id], references: [id])
  contractor Contractor? @relation(fields: [contractor_id], references: [id])
  invoice    Invoice?    @relation(fields: [invoice_id], references: [id])
  company_id String?
  company    Company?    @relation(fields: [company_id], references: [id])

  @@index([vendor_id], name: "idx_payments_vendor_id")
  @@index([date], name: "idx_payments_date")
  @@index([company_id], name: "idx_payment_company_id")
  @@map("payments")
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  vendor_id  String
  amount     Float
  tax_amount Float?        @default(0)
  total      Float
  due_date   DateTime
  status     InvoiceStatus @default(DRAFT)
  notes      String?
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  vendor     Vendor    @relation(fields: [vendor_id], references: [id])
  payments   Payment[]
  company_id String?
  company    Company?  @relation(fields: [company_id], references: [id])

  @@index([vendor_id], name: "idx_invoices_vendor_id")
  @@index([status], name: "idx_invoices_status")
  @@index([company_id], name: "idx_invoice_company_id")
  @@map("invoices")
}

model Budget {
  id          String         @id @default(cuid())
  project_id  String
  site_id     String?
  category    BudgetCategory @default(OTHER)
  allocated   Float          @default(0)
  spent       Float          @default(0)
  description String?
  created_by  String
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  project    Project  @relation(fields: [project_id], references: [id])
  site       Site?    @relation(fields: [site_id], references: [id])
  creator    User     @relation(fields: [created_by], references: [id])
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([project_id], name: "idx_budgets_project_id")
  @@index([site_id], name: "idx_budgets_site_id")
  @@index([company_id], name: "idx_budget_company_id")
  @@map("budgets")
}

model Cashbook {
  id          String       @id @default(cuid())
  date        DateTime     @db.Date
  type        CashbookType
  amount      Float
  reference   String?
  description String?
  category    String?
  project_id  String?
  site_id     String?
  vendor_id   String?
  recorded_by String
  created_at  DateTime     @default(now())

  project    Project? @relation(fields: [project_id], references: [id])
  site       Site?    @relation(fields: [site_id], references: [id])
  vendor     Vendor?  @relation(fields: [vendor_id], references: [id])
  recorder   User     @relation(fields: [recorded_by], references: [id])
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([date], name: "idx_cashbook_date")
  @@index([type], name: "idx_cashbook_type")
  @@index([project_id], name: "idx_cashbook_project_id")
  @@index([site_id], name: "idx_cashbook_site_id")
  @@index([company_id], name: "idx_cashbook_company_id")
  @@map("cashbook")
}

model Account {
  id         String      @id @default(cuid())
  name       String
  type       AccountType
  balance    Float       @default(0)
  parent_id  String?
  is_active  Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  company_id String?
  company    Company?    @relation(fields: [company_id], references: [id])

  @@index([company_id], name: "idx_account_company_id")
  @@map("accounts")
}

// ─── Documents & Notifications ───────────────────────────

model Document {
  id          String   @id @default(cuid())
  name        String
  file_url    String
  entity_type String
  entity_id   String
  uploaded_by String
  category    String?
  file_size   Int?
  created_at  DateTime @default(now())

  uploader   User              @relation(fields: [uploaded_by], references: [id])
  versions   DocumentVersion[]
  tags       DocumentTag[]
  company_id String?
  company    Company?          @relation(fields: [company_id], references: [id])

  @@index([entity_type, entity_id], name: "idx_documents_entity")
  @@index([company_id], name: "idx_document_company_id")
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  document_id String
  version     Int
  file_url    String
  notes       String?
  created_at  DateTime @default(now())

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id], name: "idx_doc_versions_document_id")
  @@map("document_versions")
}

model DocumentTag {
  id          String @id @default(cuid())
  document_id String
  tag         String

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id], name: "idx_doc_tags_document_id")
  @@index([tag], name: "idx_doc_tags_tag")
  @@map("document_tags")
}

model Notification {
  id          String   @id @default(cuid())
  user_id     String
  title       String
  message     String
  type        String?
  link        String?
  priority    String?  @default("NORMAL")
  is_read     Boolean  @default(false)
  entity_type String?
  entity_id   String?
  created_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([user_id], name: "idx_notifications_user_id")
  @@index([is_read], name: "idx_notifications_is_read")
  @@index([company_id], name: "idx_notification_company_id")
  @@map("notifications")
}

// ─── Reports & Change Orders ─────────────────────────────

model DailyReport {
  id           String   @id @default(cuid())
  project_id   String?
  site_id      String
  submitted_by String
  report_date  DateTime @db.Date

  // Basic Info
  summary     String
  weather     String?
  temperature Float?
  start_time  DateTime?
  end_time    DateTime?

  // Progress
  work_completed        String?
  work_in_progress      String?
  tomorrow_plan         String? // Pending Work
  completion_percentage Float?
  reasons_for_delay     String?

  // Observations
  safety_observations  String?
  quality_observations String?
  visitor_notes        String?
  remarks              String?

  // Legacy JSON fields (keep for backwards compatibility but we'll use dynamic fetching going forward)
  workers_count      Int?
  materials_consumed Json?
  equipment_used     Json?
  issues_faced       Json?
  attendance_data    Json?
  expenses_data      Json?
  photos             Json?

  // Status & Audit
  status     DailyReportStatus @default(DRAFT)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
  deleted_at DateTime?

  company_id String?

  // Relations
  project               Project?              @relation(fields: [project_id], references: [id])
  site                  Site                  @relation(fields: [site_id], references: [id])
  submitter             User                  @relation(fields: [submitted_by], references: [id])
  company               Company?              @relation(fields: [company_id], references: [id])
  material_consumptions MaterialConsumption[]

  @@unique([site_id, report_date, deleted_at]) // One DPR per site per day
  @@index([project_id], name: "idx_daily_reports_project_id")
  @@index([site_id], name: "idx_daily_reports_site_id")
  @@index([report_date], name: "idx_daily_reports_date")
  @@index([company_id], name: "idx_dailyreport_company_id")
  @@map("daily_reports")
}

model WeeklyReport {
  id           String  @id @default(cuid())
  project_id   String
  site_id      String?
  generated_by String

  week_start_date DateTime @db.Date
  week_end_date   DateTime @db.Date

  // Summaries
  completed_work     String?
  pending_work       String?
  delay_summary      String?
  major_achievements String?
  major_risks        String?
  site_health        String? // E.g., 'ON_TRACK', 'AT_RISK', 'DELAYED'

  // Aggregated Data
  attendance_summary   Json?
  material_consumption Json?
  budget_impact        Float?

  // Status & Audit
  status     WeeklyReportStatus @default(DRAFT)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  deleted_at DateTime?

  company_id String?

  // Relations
  project   Project  @relation(fields: [project_id], references: [id])
  site      Site?    @relation(fields: [site_id], references: [id])
  generator User     @relation(fields: [generated_by], references: [id])
  company   Company? @relation(fields: [company_id], references: [id])

  @@index([project_id], name: "idx_weekly_reports_project_id")
  @@index([site_id], name: "idx_weekly_reports_site_id")
  @@index([week_start_date, week_end_date], name: "idx_weekly_reports_date_range")
  @@index([company_id], name: "idx_weeklyreport_company_id")
  @@map("weekly_reports")
}

model ChangeOrder {
  id              String            @id @default(cuid())
  project_id      String
  title           String
  description     String
  cost_impact     Float?
  schedule_impact Int?
  status          ChangeOrderStatus @default(PROPOSED)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  project Project @relation(fields: [project_id], references: [id])

  @@index([project_id], name: "idx_change_orders_project_id")
  @@map("change_orders")
}

model Report {
  id           String   @id @default(cuid())
  name         String
  type         String // "attendance", "inventory", "finance", "project", "workforce", "vendor"
  filters      Json?
  generated_by String
  file_url     String?
  created_at   DateTime @default(now())

  generator  User     @relation(fields: [generated_by], references: [id])
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([type], name: "idx_reports_type")
  @@index([company_id], name: "idx_report_company_id")
  @@map("reports")
}

// ─── Activity Logging ────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  user_id     String
  entity_type String
  entity_id   String
  action      String
  metadata    Json?
  created_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([entity_type, entity_id], name: "idx_activity_logs_entity")
  @@index([user_id], name: "idx_activity_logs_user_id")
  @@index([created_at], name: "idx_activity_logs_created_at")
  @@index([company_id], name: "idx_activitylog_company_id")
  @@map("activity_logs")
}

// ─── Settings ────────────────────────────────────────────

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updated_at  DateTime @updatedAt

  @@map("settings")
}

// ─── Multi-Tenancy ────────────────────────────────────────

model Company {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users            User[]
  projects         Project[]
  workers          Worker[]
  contractors      Contractor[]
  subcontractors   Subcontractor[]
  cashbook_entries Cashbook[]
  vendors          Vendor[]
  materials        Material[]
  accounts         Account[]
  settings         CompanySetting[]
  expenses         Expense[]
  payments         Payment[]
  invoices         Invoice[]
  budgets          Budget[]
  documents        Document[]
  notifications    Notification[]
  daily_reports    DailyReport[]
  weekly_reports   WeeklyReport[]
  reports          Report[]
  activity_logs    ActivityLog[]
  tasks            Task[]
  sites            Site[]
  inventory_items  InventoryItem[]
  reminders        Reminder[]
  purchase_orders  PurchaseOrder[]
  attachments      Attachment[]
  approval_chains  ApprovalChain[]
  approval_logs    ApprovalLog[]
  memberships      CompanyMembership[]

  // Enterprise membership relations
  invitations         Invitation[]
  project_assignments ProjectAssignment[]
  site_assignments    SiteAssignment[]
  resignations        Resignation[]

  rfqs           RFQ[]
  Equipment      Equipment[]
  LabourCategory LabourCategory[]

  @@map("companies")
}

model CompanyMembership {
  id             String           @id @default(cuid())
  user_id        String
  company_id     String
  roles          Role[]
  status         MembershipStatus @default(ACTIVE)
  last_active_at DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([user_id, company_id])
  @@index([user_id], name: "idx_membership_user")
  @@index([company_id], name: "idx_membership_company")
  @@index([status], name: "idx_membership_status")
  @@map("company_memberships")
}

// ─── Enterprise: Invitations ──────────────────────────────

model Invitation {
  id          String           @id @default(cuid())
  company_id  String
  invited_by  String
  email       String
  role        Role
  status      InvitationStatus @default(PENDING)
  project_ids String[]         @default([])
  site_ids    String[]         @default([])
  expires_at  DateTime
  accepted_at DateTime?
  approved_at DateTime?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inviter User    @relation("InvitationSender", fields: [invited_by], references: [id])

  @@unique([company_id, email])
  @@index([email], name: "idx_invitation_email")
  @@index([status], name: "idx_invitation_status")
  @@index([company_id], name: "idx_invitation_company")
  @@map("invitations")
}

// ─── Enterprise: Project & Site Assignments ───────────────

model ProjectAssignment {
  id          String   @id @default(cuid())
  user_id     String
  project_id  String
  company_id  String
  role        Role
  assigned_by String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user     User    @relation("AssignedUser", fields: [user_id], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  company  Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  assigner User    @relation("AssignmentGiver", fields: [assigned_by], references: [id])

  @@unique([user_id, project_id, role])
  @@index([project_id], name: "idx_proj_assign_project")
  @@index([user_id], name: "idx_proj_assign_user")
  @@index([company_id], name: "idx_proj_assign_company")
  @@map("project_assignments")
}

model SiteAssignment {
  id          String   @id @default(cuid())
  user_id     String
  site_id     String
  company_id  String
  role        Role
  assigned_by String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user     User    @relation("SiteAssignedUser", fields: [user_id], references: [id], onDelete: Cascade)
  site     Site    @relation(fields: [site_id], references: [id], onDelete: Cascade)
  company  Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  assigner User    @relation("SiteAssignmentGiver", fields: [assigned_by], references: [id])

  @@unique([user_id, site_id, role])
  @@index([site_id], name: "idx_site_assign_site")
  @@index([user_id], name: "idx_site_assign_user")
  @@index([company_id], name: "idx_site_assign_company")
  @@map("site_assignments")
}

// ─── Enterprise: Resignations ─────────────────────────────

model Resignation {
  id               String            @id @default(cuid())
  user_id          String
  company_id       String
  reason           String
  last_working_day DateTime?         @db.Date
  feedback         String?
  status           ResignationStatus @default(PENDING)
  reviewed_by      String?
  reviewed_at      DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  user     User    @relation("ResigningUser", fields: [user_id], references: [id])
  company  Company @relation(fields: [company_id], references: [id])
  reviewer User?   @relation("ResignationReviewer", fields: [reviewed_by], references: [id])

  @@index([user_id], name: "idx_resignation_user")
  @@index([company_id], name: "idx_resignation_company")
  @@index([status], name: "idx_resignation_status")
  @@map("resignations")
}

// ─── Attachments (Photo Evidence System) ───────────────

model Attachment {
  id                   String    @id @default(cuid())
  entity_type          String // e.g., "EXPENSE", "DPR", "WORKER", "PROJECT", "INVENTORY"
  entity_id            String
  category             String? // e.g., "Progress Photo", "Invoice", "Safety Photo"
  file_name            String
  original_name        String?
  mime_type            String
  file_size            Int?
  image_width          Int?
  image_height         Int?
  cloudinary_public_id String?
  secure_url           String
  thumbnail_url        String?
  uploaded_by          String
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime? // For soft deletes

  uploader   User     @relation(fields: [uploaded_by], references: [id])
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([entity_type, entity_id], name: "idx_attachments_entity")
  @@index([company_id], name: "idx_attachment_company_id")
  @@map("attachments")
}

// ─── Approval Workflow ────────────────────────────

model ApprovalChain {
  id          String   @id @default(cuid())
  company_id  String
  entity_type String // "EXPENSE", "PO", "BUDGET_CHANGE", "LEAVE", "CASHBOOK", "ADVANCE_SALARY", "VENDOR_PAYMENT", "INVOICE"
  name        String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  steps   ApprovalStep[]

  @@unique([company_id, entity_type])
  @@map("approval_chains")
}

model ApprovalStep {
  id         String  @id @default(cuid())
  chain_id   String
  step_order Int
  role       Role
  label      String? // e.g. "Supervisor Review", "Manager Approval"

  chain ApprovalChain @relation(fields: [chain_id], references: [id], onDelete: Cascade)

  @@unique([chain_id, step_order])
  @@map("approval_steps")
}

model ApprovalLog {
  id          String   @id @default(cuid())
  entity_type String
  entity_id   String
  step_order  Int
  role        Role
  action      String // "APPROVED", "REJECTED", "ESCALATED"
  user_id     String
  comments    String?
  created_at  DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([entity_type, entity_id], name: "idx_approval_logs_entity")
  @@index([company_id], name: "idx_approvallog_company_id")
  @@map("approval_logs")
}

model CompanySetting {
  id          String   @id @default(cuid())
  company_id  String
  key         String
  value       String
  description String?
  updated_at  DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, key])
  @@map("company_settings")
}

model Reminder {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  user_id     String
  entity_type String?
  entity_id   String?
  status      String   @default("PENDING") // PENDING, SENT, CANCELLED
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id])

  @@index([user_id], name: "idx_reminders_user_id")
  @@index([date], name: "idx_reminders_date")
  @@index([company_id], name: "idx_reminder_company_id")
  @@map("reminders")
}

// ─── BOQ & Cost Intelligence ──────────────────────────────

model BOQ {
  id                   String    @id @default(cuid())
  project_id           String
  version              Int       @default(1)
  status               BOQStatus @default(DRAFT)
  total_estimated_cost Float     @default(0)
  created_by           String
  approved_by          String?
  notes                String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  project    Project       @relation(fields: [project_id], references: [id])
  creator    User          @relation("BOQCreator", fields: [created_by], references: [id])
  approver   User?         @relation("BOQApprover", fields: [approved_by], references: [id])
  categories BOQCategory[]

  @@index([project_id])
  @@map("boqs")
}

model BOQCategory {
  id         String   @id @default(cuid())
  boq_id     String
  name       String
  parent_id  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  boq      BOQ           @relation(fields: [boq_id], references: [id], onDelete: Cascade)
  parent   BOQCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children BOQCategory[] @relation("CategoryHierarchy")
  items    BOQItem[]

  @@index([boq_id])
  @@index([parent_id])
  @@map("boq_categories")
}

model BOQItem {
  id             String   @id @default(cuid())
  category_id    String
  material_id    String?
  code           String?
  description    String
  quantity       Float
  used_quantity  Float    @default(0)
  unit           String
  material_rate  Float    @default(0)
  labour_rate    Float    @default(0)
  equipment_rate Float    @default(0)
  other_rate     Float    @default(0)
  total_rate     Float    @default(0) // Pre-calculated
  total_amount   Float    @default(0) // Pre-calculated
  remarks        String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  category BOQCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  material Material?   @relation(fields: [material_id], references: [id])

  @@index([category_id])
  @@map("boq_items")
}
