{
  "name": "apniestate-backend",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev -p 3001",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie": "^1.1.1",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "prisma": "^6.16.2",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
