# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Database
# Connect to your local PostgreSQL instance or cloud provider (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/apniestate?schema=public"

# JWT Auth
# Generate random 256-bit strings for these: `openssl rand -base64 32`
JWT_SECRET=generate-a-secure-random-string-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-another-secure-random-string-here
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
# URL of your deployed frontend to allow CORS
FRONTEND_URL=http://localhost:5173

# Storage (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3 Configuration (Required only if STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=apniestate-files
S3_ACCESS_KEY=your-aws-access-key
S3_SECRET_KEY=your-aws-secret-key

# Logging
LOG_LEVEL=info
