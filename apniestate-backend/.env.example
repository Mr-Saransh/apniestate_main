# Application
NODE_ENV=development
APP_URL=http://localhost:3001
PORT=3001

# Database
DATABASE_URL=postgresql://apniestate:devpassword@localhost:5432/apniestate_dev

# JWT
JWT_SECRET=change-me-to-a-256-bit-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-256-bit-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# S3 (only if STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=apniestate-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Logging
LOG_LEVEL=info



